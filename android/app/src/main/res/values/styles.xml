<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light theme: WebView reports prefers-color-scheme: light -->
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg_light</item>
        <item name="android:statusBarColor">@color/bg_light</item>
        <item name="android:navigationBarColor">@color/bg_light</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <color name="bg_light">#F4F5F8</color>
    <color name="bg_dark">#0F1115</color>
    <color name="ic_background">#0F1115</color>
</resources>
